{
  "name": "notion-multipart-uploader",
  "version": "2.4.1",
  "description": "Production multipart uploader for the Notion API. Upload local files over 20 MiB without external hosting—automatic 10 MiB chunking, progress, retries, cancellation, and concurrent part uploads. Returns a Notion file_upload ID ready to attach to pages and blocks.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test test.mock.js",
    "test:integration": "node test.js"
  },
  "keywords": [
    "notion",
    "notion-api",
    "notion-sdk",
    "multipart",
    "form-data",
    "upload",
    "audio",
    "image",
    "pdf",
    "notion-file-upload",
    "notion-file-uploads",
    "multipart-upload",
    "large-file-upload",
    "notion-mcp",
    "mcp",
    "typescript",
    "nodejs"
  ],
  "author": "Shoubhik Saha <officialshoubhiksaha@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shoubhiksaha/notion-multipart-uploader.git"
  },
  "bugs": {
    "url": "https://github.com/shoubhiksaha/notion-multipart-uploader/issues"
  },
  "homepage": "https://github.com/shoubhiksaha/notion-multipart-uploader#readme",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  }
}
